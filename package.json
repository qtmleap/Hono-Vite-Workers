    "@tanstack/react-router": "^1.170.46",
    "@zodios/core": "^10.9.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@commitlint/config-conventional": "^21.2.4",
