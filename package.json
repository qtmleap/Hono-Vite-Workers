    "@tanstack/react-router": "^1.170.36",
    "@zodios/core": "^10.9.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@hono/vite-dev-server": "^0.26.1",
